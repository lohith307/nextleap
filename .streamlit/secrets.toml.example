# Streamlit Secrets Configuration Template
# For local testing, copy this file to: .streamlit/secrets.toml
# On Streamlit Community Cloud, paste these under: App Settings -> Secrets

# Groq Configuration (Recommended - ultra-fast inference)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY = "gsk_..."
LLM_MODEL = "llama-3.3-70b-versatile"

# Optional alternative providers (falls back to Grounded AI Reasoning Engine if empty)
OPENAI_API_KEY = "sk-..."
GEMINI_API_KEY = "AIzaSy..."
